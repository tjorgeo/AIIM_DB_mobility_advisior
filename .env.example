UNI_GPT_API_KEY = api_key_here

# Langfuse LLM observability (optional). Without these keys tracing is a no-op
# and the app runs exactly as before. Get keys from Langfuse UI → Settings → API Keys.
LANGFUSE_PUBLIC_KEY = pk-lf-...
LANGFUSE_SECRET_KEY = sk-lf-...
# EU cloud (default). US cloud: https://us.cloud.langfuse.com — or your self-hosted URL.
LANGFUSE_BASE_URL = https://cloud.langfuse.com
# Optional: segments traces by environment and tags them with a release/build.
LANGFUSE_TRACING_ENVIRONMENT = development
LANGFUSE_RELEASE =